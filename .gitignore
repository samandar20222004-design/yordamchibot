# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# --- Virtual muhitlar ---
.venv/
venv/
env/

# --- Maxfiy sozlamalar (hech qachon commit qilinmaydi) ---
# `.env`, `.env.*` va `*.env` — barcha shakllar (`.env.local`, `.env.prod`,
# `prod.env`, ...). `!.env.example` MUSTAQOID kelganda ORTIDA turadi:
# `.env.*` bilan birga kelganda faqat shu qoida ildizdagi kanonik
# `.env.example` ni qayta ko'rsatadi.
.env
.env.*
*.env
!.env.example

# --- Maxfiy kalitlar / sertifikatlar (qo'shimcha to'siq) ---
# Dsn/Parol/JWT kalitlari, xizmat hisob kalitlari, Render/Aiven JSON
# eksportlari hech qachon repozitoriyaga tushmasligi kerak.
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
.netrc
.pgpass
secrets/
.secrets/
credentials*.json
service-account*.json
*_rsa.json
*.enc

# Git keshidagi o'chirishdan keyin qoladigan mahalliy nusxa
.env.removed
env_backup/
env-backup/

# --- Ma'lumotlar bazasi / lokal fayllar ---
*.db
*.sqlite
*.sqlite3

# --- Vaqtinchalik loglar va test artefaktlari (PHASE 14, 56-band) ---
*.log
logs/
tmp/
temp/
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# --- Test runner chiqaradigan vaqtinchalik media/kataloglar ---
telegram_bot/temp_media/
telegram_bot/uploads/
downloads/

# --- pgserver (testlar ko'taradigan vaqtinchalik PostgreSQL ma'lumotlari) ---
yordamchi_pg_*/
.pgserver/

# --- IDE / OS ---
.idea/
.vscode/
.DS_Store
Thumbs.db
