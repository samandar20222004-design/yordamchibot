{
  "name": "postassist-miniapp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PostAssist Telegram Mini App (Vite + React + TypeScript)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-dist.mjs && node scripts/compress-dist.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "typescript": "~5.9.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
