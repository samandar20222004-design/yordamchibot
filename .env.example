# ============================================================
# PostAssistBot — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# --- REQUIRED ---
BOT_TOKEN=your_telegram_bot_token_here
BOT_USERNAME=PostAssistrobot
# Neon misoli: postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/dbname
# SSL rejimi (Neon/Render TLS'ni talab qiladi). Bo'sh = avtomatik:
# URL'da sslmode= bo'lsa o'sha qo'llanadi, lokal hostga 'prefer',
# masofaviy bazaga 'require'. Qiymatlar: disable|allow|prefer|require|verify-full
DB_SSLMODE=

# --- ADMIN ---
# Primary admin Telegram user ID (SuperAdmin)
ADMIN_ID=123456789
# Comma-separated admin user IDs (e.g. "123456789,987654321")
ADMIN_IDS=

# --- AI PROVIDER API KEYS (at least one recommended) ---
# Gemini — aistudio.google.com (1500 req/day free)
GEMINI_API_KEY=
# Groq — console.groq.com (1000 req/day free)
GROQ_API_KEY=
# OpenRouter — openrouter.ai (:free models)
OPENROUTER_API_KEY=
# Mistral — console.mistral.ai (~1B tokens/month free)
MISTRAL_API_KEY=
# Cerebras — cloud.cerebras.ai (1M tokens/day free)
CEREBRAS_API_KEY=

# --- AI PARAMETERS (optional, defaults shown) ---
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2048
AI_TOP_P=0.95
AI_REQUEST_TIMEOUT=45
AI_CONNECT_TIMEOUT=10
AI_MAX_PROMPT_CHARS=3000
AI_CONTEXT_MESSAGES=6
AI_MAX_CONTEXT_CHARS=4000
AI_EXTRA_CONTEXT=
AI_MODEL_DISCOVERY=1
MAX_CONCURRENT_AI=2
# 🖼 Vision (Rasmdan post yaratish) — rasm tahlili chegaralari
VISION_MAX_FILE_BYTES=10485760
VISION_HARD_TIMEOUT=45
# 🖼 Vision uchun BARQAROR Gemini modeli. Bo'sh qoldirilsa gemini-2.5-flash.
# Eslatma: gemini-1.5-flash Google tomonidan 2025-09-29 da o'chirilgan
# (404 qaytaradi) — uni faqat kalitingizda amalda bo'lsa belgilang; aks
# holda barqaror zaxira zanjir avtomatik ishlaydi.
GEMINI_VISION_MODEL=gemini-2.5-flash

# --- AI ENDPOINTS (optional, override only if needed) ---
GROQ_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
GEMINI_BASE=https://generativelanguage.googleapis.com/v1beta/models
OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
MISTRAL_ENDPOINT=https://api.mistral.ai/v1/chat/completions
CEREBRAS_ENDPOINT=https://api.cerebras.ai/v1/chat/completions
POLLINATIONS_ENDPOINT=https://text.pollinations.ai/openai

# --- DEPLOYMENT ---
PORT=10000
SENTRY_DSN=
