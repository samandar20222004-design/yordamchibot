# Maxfiy fayllarni brauzerdan yopish (Apache). Ochiq qoladiganlar: webhook.php, cron.php?key=, setup.php?key=
Options -Indexes
<FilesMatch "^(config\.php|config\.example\.php|bootstrap\.php|.*\.sql|.*\.md|.*\.log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Payme: Authorization sarlavhasi PHP'ga yetib borsin (CGI/FastCGI hostinglar uchun)
<IfModule mod_setenvif.c>
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>
