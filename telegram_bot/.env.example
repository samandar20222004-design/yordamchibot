BOT_TOKEN=your_telegram_bot_token_here
ADMIN_ID=your_telegram_user_id_here
DATABASE_URL=postgresql://username:password@localhost:5432/dbname
PORT=10000

# --- AI (kamida bittasi kerak; barchasi bepul) ---
# Gemini: https://aistudio.google.com -> API key (kuniga ~1500 so'rov bepul)
GEMINI_API_KEY=
# Groq: https://console.groq.com -> API key (kuniga ~1000 so'rov bepul)
GROQ_API_KEY=
# OpenRouter (ixtiyoriy): https://openrouter.ai -> :free modellar uchun
OPENROUTER_API_KEY=
# Mistral (ixtiyoriy): https://console.mistral.ai -> oyiga ~1 mlrd token bepul
MISTRAL_API_KEY=
# Cerebras (ixtiyoriy): https://cloud.cerebras.ai -> kuniga 1M token bepul
CEREBRAS_API_KEY=

# --- Render Free optimallashtirish (ixtiyoriy, standart qiymatlar) ---
# PostgreSQL ulanishlar pool'i
DB_POOL_MIN=0
DB_POOL_MAX=5
DB_CONNECT_TIMEOUT=20
# Neon kabi TLS talab qiladigan bazalar uchun SSL rejimi.
# Bo'sh = avtomatik: masofaviy bazaga 'require', localhost'ga 'prefer'.
# URL ichida sslmode= bo'lsa URL'dagi ustun. Qiymatlar: disable|allow|prefer|require
DB_SSLMODE=
# Har bir scheduler ishlashida ko'pi bilan shuncha post yuboriladi
POST_BATCH_SIZE=100
# TTL kesh (ixtiyoriy)
DB_CACHE_ENABLED=1
DB_SETTINGS_CACHE_TTL=60
DB_SPONSORS_CACHE_TTL=30
DB_USER_CACHE_TTL=15
DB_STATS_CACHE_TTL=30

# --- AI kontekst/parametrlar (ixtiyoriy; admin panelda ham sozlanadi) ---
# AI: bir vaqtda nechta so'rov ishlashi mumkin
MAX_CONCURRENT_AI=2
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=1024
AI_TOP_P=1.0
AI_MAX_PROMPT_CHARS=3000
AI_CONTEXT_MESSAGES=6
AI_MAX_CONTEXT_CHARS=4000
# 🖼 Vision (Rasmdan post yaratish): rasm hajmi limiti va qat'iy vaqt chegarasi
VISION_MAX_FILE_BYTES=10485760
VISION_HARD_TIMEOUT=45
# 🖼 Vision uchun BARQAROR Gemini modeli. Bo'sh qoldirilsa gemini-2.5-flash.
# Eslatma: gemini-1.5-flash Google tomonidan 2025-09-29 da o'chirilgan
# (404 qaytaradi) — uni faqat kalitingizda amalda bo'lsa belgilang; aks
# holda barqaror zaxira zanjir avtomatik ishlaydi.
GEMINI_VISION_MODEL=gemini-2.5-flash
