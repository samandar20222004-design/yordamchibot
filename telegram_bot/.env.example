# ============================================================
# PostAssist V2 — Environment Variables (10-BOSQICH, FINAL)
#
# Bu fayl — KONONIK (canonical) konfiguratsiya hujjati. Uni ikki joyda
# AYNI BIR mazmunda saqlaymiz (Render Root Directory = `telegram_bot`):
#     1) .env.example                  → Docker / lokal / repo hujjati
#     2) telegram_bot/.env.example      → Render (Root Directory = telegram_bot)
# Dublikat PARAMETRLAR YO'Q (har bir o'zgaruvchi faylda BITTA marta) va
# ikki fayl PARITYETI `tests/env_docs_parity_test.py` bilan himoyalangan.
#
# Nusxalash:   cp .env.example .env        (so'ng qiymatlarni to'ldiring)
# Docker:       docker-compose.yml shu .env faylini avtomatik o'qiydi.
# VPS/systemd:  EnvironmentFile=/etc/postassist.env (export YO'Q format).
# Render:       Environment paneliga KEY = qiymat (bu fayldan ko'chirilsa
#               har bir o'zgaruvchi AYNAN BITTA marta kiritiladi).
# DIQQAT: ilova `python-dotenv` ISHLATMAYDI — .env faylni o'zi o'qib o'tirmaydi.
# Uni muhitga eksport qilish kerak (Render/Docker/systemd bu ishni o'zi qiladi).
#
# XAVFSIZLIK: .env fayliga HAQIQIY kalitlarni yozing — u `.gitignore`'da,
# repozitoriyga HECH QACHON commit qilinmaydi. Bu fayldagi qiymatlar faqat
# namunadir (maxfiy hisoblagichlar bo'sh qoldirilgan).
# ============================================================

# ---------------- MAJBURIY ----------------
# QAT'IY 2 ta: BOT_TOKEN va DATABASE_URL bo'lmasa config.py `RuntimeError`
# beradi (bot ishga tushmaydi). ADMIN_ID/ADMIN_IDS — admin paneli uchun kerak.
# BotFather bergan token (masalan: 123456789:AAExample...)
BOT_TOKEN=your_telegram_bot_token_here
BOT_USERNAME=PostAssistrobot
# Bot versiyasi (ixtiyoriy) — «ℹ️ Bot haqida» ekrani va monitoring'da
# ko'rsatiladigan versiya raqami. Default: 2.0
BOT_VERSION=2.0
# Aiven misoli: postgres://avnadmin:pass@pg-xxx.a.aivencloud.com:12345/defaultdb?sslmode=require
# Render DB misoli: postgresql://user:pass@dpg-xxxx-a.oregon-postgres.render.com/dbname
# Docker (development): postgresql://postassist:postassist@postgres:5432/postassist
# PRODUCTION TALAB: masofaviy DB uchun `?sslmode=require` (Aiven TLS talab qiladi).
# `postgres://` prefiksi config.py da avtomatik `postgresql://` ga o'tkaziladi.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# SSL rejimi (Aiven/Render TLS'ni talab qiladi). Bo'sh = avtomatik:
# URL'da sslmode= bo'lsa o'sha qo'llanadi, lokal hostga 'prefer',
# masofaviy bazaga 'require'. Qiymatlar: disable|allow|prefer|require|verify-full
DB_SSLMODE=

# ---------------- 🛡 P0-A: MUHIT VA MOCK SIYOSATI (Phase A) ----------------
# ENVIRONMENT — muhit nomi: production | development | test.
#   Qiymat bo'sh yoki yo'qolsa kod DEFAULTI `production` (fail-closed), ya'ni
#   xavfsiz rejim o'z-o'zidan tanlanadi. Prodda `production` DAN O'ZGARTIRMANG.
# AI_ALLOW_MOCK — MockProvider'ni (deterministik SHABLON javoblar) qo'shish:
#   0 = o'chirilgan (standart); 1 = ataylab yoqish (prodda faqat sinov uchun).
#   Ruxsat etilgan haqiqiy qiymatlar: 1|true|yes|on|y|ha (katta-kichik farqsiz).
#
# Qoida (services/ai/providers.py::mock_is_allowed):
#   Mock FAQAT ENVIRONMENT=development/test YOKI AI_ALLOW_MOCK=1 bo'lganda
#   zanjirda qatnashadi. Production'da haqiqiy provayderlar (Gemini/Groq/
#   OpenRouter...) ishlamasa — SOXTA GENERATSIYA YO'Q: zanjir oshkora
#   NoConfiguredProviderError/AllProvidersFailedError bilan tugaydi,
#   foydalanuvchi xavfsiz xabar oladi («AI hozirda mavjud emas…») va bron
#   qilingan AI kvotasi TO'LIQ qaytariladi.
ENVIRONMENT=production
AI_ALLOW_MOCK=0

# ---------------- ADMIN / RBAC (6-BOSQICH) ----------------
# Primary admin Telegram user ID (SuperAdmin / OWNER meros qilib oladi)
ADMIN_ID=123456789
# Vergul bilan ajratilgan admin ID'lari: "123456789,987654321"
# 💬 QO'LLAB-QUVVATLASH (4-QISM): foydalanuvchining bir martalik murojaati
# (one-time ticket) shu ro'yxatdagi HAR BIR adminga yuboriladi. Admin bot
# yuborgan murojaat xabariga Telegram'ning «Reply» (Javob berish) funksiyasi
# bilan yozsa — javob avtomatik foydalanuvchiga yetkaziladi. Ro'yxat bo'sh
# bo'lsa murojaat hech kimga bormaydi va foydalanuvchiga halol javob beriladi.
ADMIN_IDS=
# RBAC ruxsatlarini keshda saqlash vaqti (soniya) va rol tekshiruvi uchun
# DB'ga beriladigan maksimal vaqt (soniya, timeout'da kesh qiymati ishlatiladi).
RBAC_CACHE_TTL=60
RBAC_DB_TIMEOUT=2

# ---------------- DATABASE POOL (Aiven uchun muhim) ----------------
# Ulashishlar pool'i: min..max (ThreadedConnectionPool 2..10). Aiven ulanish limitiga
# qarab kamaytiring. DIQQAT: DB_POOL_SIZE/DB_POOL_MAX Render'da qo'lda 5 qilib qo'yilgan
# bo'lsa, koddagi standart 10 ni bekor qiladi.
# DB_POOL_MIN=2 (1-BOSQICH): bot startida 2 ta ulanish OLDINDAN ochiladi va
# `SELECT 1;` bilan ISITILADI (database.warm_pool) — birinchi /start TLS
# handshake kutmaydi, shuning uchun foydalanuvchi ~0.3-0.8s tez javob oladi.
# DB_POOL_MIN=0 qilsangiz, har bir so'rov ulanish ochishni to'liq to'laydi.
DB_POOL_MIN=2
DB_POOL_MAX=10
# 10-BOSQICH: pool hajmining qulay aliasi — berilsa DB_POOL_MAX ustidan g'olib.
DB_POOL_SIZE=10
# 1-BOSQICH: ulanish vaqti chegarasi 20s -> 8s. Aiven/Render free-tier da
# ulanish 8s dan oshsa muvaffaqiyatsiz bo'ladi; tez chegara + avtomatik
# qayta urinish tezroq tiklanish beradi.
DB_CONNECT_TIMEOUT=8
# 1-BOSQICH: Aiven idle-timeout ulanishni o'ldirganda avtomatik QAYTA
# ulanish urinishlari. 1 = bir marta qayta urinadi (jami 2 urinish).
DB_RECONNECT_RETRIES=1
# PostAssist V2 (5-BOSQICH): eski bazalarda NOT VALID holatda qolgan
# FK/CHECK constraintlarni ishga tushishda tekshirib tugatish.
# Katta jadvallarda qulf olishi mumkin — yuklama kam paytda yoqing.
# Ruxsat: 1|true|yes|on (bo'sh = o'chirilgan; /admin buyrug'i bilan qo'lda
# bajarish tavsiya etiladi).
DB_VALIDATE_INTEGRITY=
# Kesh sozlamalari (ixtiyoriy; defaultlar ko'rsatilgan). DB_CACHE_ENABLED faqat
# aynan "1" bo'lganda yoqiladi (0 = har bir so'rov bazaga).
DB_CACHE_ENABLED=1
DB_SETTINGS_CACHE_TTL=60
DB_SPONSORS_CACHE_TTL=30
DB_USER_CACHE_TTL=15
DB_STATS_CACHE_TTL=30
# Foydalanuvchi profili (til, PRO, ball, kanallar soni) RAM'da shuncha soniya turadi
# (30..3600, standart 300 = 5 daqiqa); faqat o'zgarganda yangilanadi.
DB_PROFILE_CACHE_TTL=300

# ---------------- AI PROVIDER API KEYS (kamida bittasi tavsiya) ----------------
# Gemini — aistudio.google.com (1500 req/day free)
GEMINI_API_KEY=
# GOOGLE_API_KEY — GEMINI_API_KEY'ning muqobili (alias); biri bo'lsa yetadi.
GOOGLE_API_KEY=
# Groq — console.groq.com (1000 req/day free)
GROQ_API_KEY=
# OpenRouter — openrouter.ai (:free models)
OPENROUTER_API_KEY=
# Mistral — console.mistral.ai (~1B tokens/month free)
MISTRAL_API_KEY=
# Cerebras — cloud.cerebras.ai (1M tokens/day free)
CEREBRAS_API_KEY=
# SambaNova Cloud — cloud.sambanova.ai (10-30 RPM free)
SAMBANOVA_API_KEY=
# Cloudflare Workers AI — dash.cloudflare.com (10K neurons/day free)
# Token + Account ID juftligi kerak; endpoint ichida account id ishlatiladi.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ---------------- AI PARAMETERS (optional, defaults shown) ----------------
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2048
AI_TOP_P=0.95
AI_REQUEST_TIMEOUT=45
AI_CONNECT_TIMEOUT=10
AI_MAX_PROMPT_CHARS=3000
AI_CONTEXT_MESSAGES=6
AI_MAX_CONTEXT_CHARS=4000
AI_EXTRA_CONTEXT=
# Bepul provayderlarda mavjud modellarni avtomatik aniqlash. Faqat aynan "1"
# yoqadi (0 = kod ichidagi qattiq ro'yxat ishlataladi).
AI_MODEL_DISCOVERY=1

# ---------------- ⚡️ AI NAVBAT / KONKURENTLIK (Phase 4 va 13) ----------------
# Ikkita qatlam bor — ikkalasi ham saqlangan (eski kodga moslik uchun):
#   MAX_CONCURRENT_AI   → utils/ai_agent.py ichidagi global semaphore;
#   MAX_AI_CONCURRENCY  → services/ai/concurrency.py navbat menejeri
#                         (orchestrator/Autopilot shu navbatdan o'tadi).
# Bepul provayder RPM limitlaridan oshib ketmaslik uchun kichik ushlang.
MAX_CONCURRENT_AI=2
MAX_AI_CONCURRENCY=5
MAX_AI_QUEUE=20
AI_QUEUE_TIMEOUT=30.0

# ---------------- ⏱ AI TIMEOUT VA PRO-AUDIT QATLAMI ----------------
# AI_TOTAL_TIMEOUT — bitta tashqi HTTP urinishi uchun qat'iy muddat (soniya);
# AI_HARD_TIMEOUT  — BUTUN provayder zanjiri uchun umumiy muddat (soniya).
# Zanjir shu vaqtda javob bermasa chaqiruv bekor qilinadi (event loop
# bloklanmaydi) va bron qilingan kvota qaytariladi.
AI_TOTAL_TIMEOUT=35
AI_HARD_TIMEOUT=15
# PRO tarifidagi 2-bosqichli «deep audit» (sarat/CTA yaxshilash). FREE'da
# 2-bosqich umuman chaqirilmaydi. AI_PRO_AUDIT_TIMEOUT — 2-bosqichga ajratiladigan
# vaqt (bo'sh = AI_HARD_TIMEOUT bilan bir xil); AI_PRO_TWO_STAGE=0 — butunlay
# o'chirish (0|false|no|off). Sinov va og'ir yuklama paytida o'chirish mumkin.
AI_PRO_AUDIT_TIMEOUT=15
AI_PRO_TWO_STAGE=1

# ---------------- AI FALLBACK (4-BOSQICH: Multi-Provider Chain) ----------------
# Strict per-provider timeouts (seconds). On timeout/429/5xx the bot
# immediately fails over: Gemini -> Groq -> OpenRouter -> (extended chain).
AI_PROVIDER_CONNECT_TIMEOUT=2
AI_PROVIDER_READ_TIMEOUT=6
AI_PROVIDER_TOTAL_TIMEOUT=7
# Zanjir tartibi (bo'sh = to'liq zanjir), masalan: gemini,groq,openrouter
AI_PROVIDER_CHAIN=
# Kalitsiz oxirgi zaxira — Pollinations (tashqi, bepul, SLAS'SIZ). Xavfsizlik
# va barqarorlik uchun DEFAULTI O'CHIRILGAN: prodda 1 QILMANG (faqat lokal
# sinovda yoqing). Ruxsat: 1|true|yes|on|enable|enabled.
ENABLE_POLLINATIONS_FALLBACK=0

# ---------------- 🚦 AI ENGINE V2 — YAGONA SHLYUZ (gateway) ----------------
# Barcha AI so'rovlari uchun yagona kanonik kirish nuqtasi
# (services/ai_engine/gateway.py): model router (FAST/QUALITY/REASONING/
# VISION), circuit breaker (health.py) va deterministik kesh (cache.py).
# 2-BOSQICH — TEZLASH va XOTIRA HIMOYASI
# Lane Routing: FAST (qayta yozish, qisqa post, sarlavha) → Groq (eng tez)
# birinchi, keyin Gemini → fallback zanjir. Per-provider 6-8s (default 7s),
# 429/500 da darhol keyingisiga; umumiy zanjir 12-15s (default 12s).
AI_FAST_PATH_TIMEOUT=12
# Per-provider maksimal kutish (6-8s, env: AI_ENGINE_PROVIDER_TIMEOUT, default 7s).
AI_ENGINE_PROVIDER_TIMEOUT=7
# AI_CACHE_TTL — Fast Path javoblari keshi TTL (soniya). 0 = kesh o'chiriladi.
AI_CACHE_TTL=900
# AI_CACHE_MAX_ENTRIES — kesh sig'imi LRU (512MB himoyasi: default 512, hard cap 1024).
AI_CACHE_MAX_ENTRIES=512
AI_CACHE_MAX_BYTES=8388608
# Circuit Breaker: provayder ketma-ket AI_BREAKER_THRESHOLD marta xato
# bersa (429/timeout/5xx), AI_BREAKER_COOLDOWN soniyaga o'tkazib yuboriladi
# va so'rovlar SOG'LOM provayderga avto-o'tadi (legacy breaker bilan bitta
# holat). Lane timeout'lari ham env bilan bekor qilinishi mumkin:
# AI_FAST_TIMEOUT / AI_QUALITY_TIMEOUT / AI_REASONING_TIMEOUT /
# AI_VISION_TIMEOUT (bo'sh = kod ichidagi lane standartlari, default FAST 12s, boshqalar 15s).
AI_FAST_TIMEOUT=12
AI_QUALITY_TIMEOUT=15
AI_REASONING_TIMEOUT=15
AI_VISION_TIMEOUT=15
AI_BREAKER_THRESHOLD=3
AI_BREAKER_COOLDOWN=600

# ---------------- AI ENDPOINTS (faqat zarur bo'lsa o'zgartiring) ----------------
GROQ_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
GEMINI_BASE=https://generativelanguage.googleapis.com/v1beta/models
OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
MISTRAL_ENDPOINT=https://api.mistral.ai/v1/chat/completions
CEREBRAS_ENDPOINT=https://api.cerebras.ai/v1/chat/completions
SAMBANOVA_ENDPOINT=https://api.sambanova.ai/v1/chat/completions
# Bo'sh qoldirilsa kod CLOUDFLARE_ACCOUNT_ID dan endpointni o'zi yig'adi
CLOUDFLARE_ENDPOINT=
POLLINATIONS_ENDPOINT=https://text.pollinations.ai/openai
# Model discovery so'rovlari uchun manzillar (bo'sh = endpointdan avtomatik
# yig'iladi: GEMINI_BASE, GROQ_ENDPOINT/models, OpenRouter /models).
GEMINI_MODELS_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models
GROQ_MODELS_ENDPOINT=https://api.groq.com/openai/v1/models
OPENROUTER_MODELS_ENDPOINT=https://openrouter.ai/api/v1/models
# OpenRouter dinamik bepul routeri (qattiq :free model nomlari eskiradi).
OPENROUTER_FREE_ROUTER_MODEL=openrouter/free

# ---------------- 📸 VISION (Rasmdan post yaratish) ----------------
# GEMINI_VISION_MODEL — Image→Post vision modeli. BARQAROR qiymat quyidagi
# BIR qatorda: `gemini-2.5-flash`. (`gemini-1.5-flash` Google tomonidan
# 2025-09-29 da O'CHIRILGAN — bu faylda endi umuman ko'rsatilmaydi; eskirgan
# model kod tomonidan avtomatik filtrlanadi va keyingi zaxiraga o'tiladi.)
GEMINI_VISION_MODEL=gemini-2.5-flash
# Rasm hajmi chegarasi (bayt; 10 MB) va vision so'rovining qat'iy muddatlari.
VISION_MAX_FILE_BYTES=10485760
VISION_HARD_TIMEOUT=45
VISION_ANALYZER_TIMEOUT=35

# ---------------- 🎙 VOICE → POST (STT — $0 xarajat) ----------------
# Ovozli xabar → matn: 1) Groq Whisper Large v3 (bepul, tezkor),
# 2) zaxira — Gemini multimodal audio. Kalitlar: GROQ_API_KEY / GEMINI_API_KEY.
# Cheklovlar (resurs himoyasi): FREE ≤60s, PRO ≤180s, fayl ≤20 MB.
# Transkripsiya BEPUL — AI limiti/krediti faqat post generatsiyasida yechiladi.
GROQ_STT_ENDPOINT=https://api.groq.com/openai/v1/audio/transcriptions
GROQ_STT_MODEL=whisper-large-v3
# Gemini zaxira STT modeli. MUHIM: audio ham faqat BARQAROR modellar bilan
# ishlaydi — `gemini-1.5-flash` o'chirilgan, shuning uchun BU YERDA
# `gemini-2.5-flash` beriladi (kod defaulti 1.5 bo'lib qolsa ham, env qiymati
# g'olib keladi).
GEMINI_AUDIO_MODEL=gemini-2.5-flash
STT_CONNECT_TIMEOUT=8
STT_TOTAL_TIMEOUT=45

# ---------------- 📊 POST SCORE & IMPROVER (KILLER FEATURE #4) ----------------
# Baholash (score) BEPUL: kredit ham, kunlik AI kvota ham yechilmaydi.
# Faqat «✨ 95/100 ga yaxshilash» bosilganda 1 ta AI krediti atomik yechiladi
# (xatolikda qaytariladi). Baholash Gemini Flash → Groq Llama zanjiri orqali,
# AI ishlamasa lokal deterministik tahlil bilan bajariladi.
POST_SCORE_MIN_CHARS=20
POST_SCORE_MAX_CHARS=3500
POST_SCORE_TIMEOUT=20
POST_SCORE_IMPROVE_ATTEMPTS=2

# ---------------- SCHEDULER / DELIVERY (3- va 9-BOSQICH) ----------------
# Har bir scheduler tick'ida ko'pi bilan shuncha post yuboriladi
POST_BATCH_SIZE=100
# Post idempotentligi YAGONA MANBASI — DB jadvali `post_deliveries`
# ('sent' markeri + backoff retry). Yuqoridagi journal fayli esa LEGACY
# opt-in zaxira: eski deploylar/sinovlar uchun (masalan DB uzoq vaqt turg'an
# bo'lsa va restart kutilsa). Bo'sh = journal O'CHIQ (tavsiya etiladi;
# markerlar xotira + DB orqali yakunlanadi). 'off|none|0|false' = ham o'chiq.
# Yoqilsa faqat ANIQ yo'l yozing va Docker'da volume'ga ulang:
#     SENT_JOURNAL_PATH=/app/data/sent_journal.json
SENT_JOURNAL_PATH=
# Graceful shutdown: in-flight postlarning tugashi kutiladigan muddat (5–10 s).
SHUTDOWN_GRACE_SECONDS=8

# ------------- ⏱ FAZA 25: HANDLER / FON VAZIFALARI TIMEOUT CHEGARALARI -------------
# UPDATE_HANDLER_TIMEOUT_SECONDS: bitta Telegram update handleriga berilgan
# QAT'IY maksimal vaqt (soniya). "Osilib qolgan" handler qabul zanjirini
# to'xtatmasligi uchun so'nggi himoya chizig'i (watchdog) — chegaradan
# oshsa bekor qilinadi, foydalanuvchi xushmuomala javob oladi (utils/
# handler_timeout.py → main.py GuardedApplication).
UPDATE_HANDLER_TIMEOUT_SECONDS=110
# BACKGROUND_TASK_TIMEOUT_SECONDS: fon (fire-and-forget) vazifalarining
# umumiy maksimal bajarilish muddati (soniya) — task leak himoyasi; bu
# vazifalar asosiy update qabul zanjirini hech qachon bloklamaydi
# (utils/handler_timeout.py run_background_task).
BACKGROUND_TASK_TIMEOUT_SECONDS=300

# ---------------- CLEANUP (9-BOSQICH: kunlik tozalash) ----------------
# Har 24 soatda bir marta (03:00, Toshkent) eski yozuvlar tozalanadi:
# paketlar LIMIT bo'yicha bo'linadi va FOR UPDATE SKIP LOCKED bilan olinadi.
CLEANUP_CRON_HOUR=3
CLEANUP_CRON_MINUTE=0
CLEANUP_BATCH_SIZE=1000
CLEANUP_MAX_BATCHES=50
CLEANUP_DELIVERY_RETENTION_DAYS=30
CLEANUP_TEMP_RETENTION_DAYS=60

# ---------------- HEALTH MONITORING (7-BOSQICH) ----------------
# /health hisobotidagi ogohlantirish chegaralari (DEGRADED belgilash uchun).
HEALTH_DEAD_LETTER_ALERT=1
HEALTH_FAILED_ALERT=10
HEALTH_PENDING_BACKLOG_ALERT=1000
# Ko'rib chiqilmagan (pending) to'lov cheklari shunchadan oshsa — to'lovlar
# bo'limi DEGRADED hisoblanadi.
HEALTH_PENDING_RECEIPTS_ALERT=50

# ---------------- SENTRY (10-BOSQICH: xato monitoringi + maxfiylik filtri) ----------------
# Sentry DSN berilsa va sentry_sdk o'rnatilgan bo'lsa, xatolar avtomatik
# yig'iladi. MUHIM: bot token, DB paroli, karta rekvizitlari va API kalitlar
# Sentry'ga tushishidan oldin maxfiylik filtri (utils/sentry_scrubber.py)
# orqali o'chiriladi. Bo'sh = Sentry o'chirilgan (log filtri baribir faol).
SENTRY_DSN=

# ---------------- DEPLOYMENT ----------------
# Render avtomatik PORT beradi (o'zingiz qo'ymang — Render o'zi yozadi);
# Docker/VPS'da web health-server (/health/live, /health/ready) shu portda
# tinglaydi.
PORT=10000
# 1-BOSQICH: STARTUP TEZLIGI — Render FREE web service PORT'ni darhol
# ochilganini ko'rish uchun `/health/live` ni tekshiradi. Bot endi
# `start_web_server()` ni `db.init_db()` dan OLDIN ishga tushiradi, shuning
# uchun DB og'ir bo'lsa ham deploy kechikmaydi. `/health/live` baza bilan
# bog'lanmaydi (faqat process tirikligi); DB tekshiruvi `/health/ready` da.
# Render Health Check Path = /health/live (hozirgi sozlamangiz mos keladi).
#
# STALE_UPDATE_SECONDS (1-BOSQICH) — bot o'chgan paytda yig'ilgan ESKI
# xabarlar chegarasi (soniya). 600 = 10 daqiqadan eski xabar indiro'ladi
# (foydalanuvchiga ko'rinmaydi, navbatni to'smaydi). Jonli xabarlar
# Telegram'da bir necha soniyada yuboriladi, shuning uchun 600 xavfsiz.
# 0 = filtr yo'q (barcha xabarlar bajariladi). Default 600.
STALE_UPDATE_SECONDS=600
# KEEP_ALIVE_URL (1-BOSQICH) — Render FREE da instance 15 daqiqa faol
# bo'lmasa «sleep»ga ketadi va keyin so'rov kelganda QAYTA OCHILADI
# (cold start, 20-40s). Bot shu manzilga har 10 daqiqada GET yuborib
# instance'ni uyg'otib turadi. Tavsiya: UptimeRobot.com (HTTP monitor,
# 10 daqiqa interval) yoki cron-job.org. Bo'sh = keep-alive O'CHIRILGAN
# (boshqa tashqi ping yo'qsa). DIQQAT: URL'ga maxfiy token qo'ymang —
# u Render loglarida ko'rinadi.
KEEP_ALIVE_URL=
# KEEP_ALIVE_INTERVAL_SECONDS — ping oralig'i (soniya, minimal 60).
# Render free-tier uchun 600 (10 daqiqa) yetarli.
KEEP_ALIVE_INTERVAL_SECONDS=600

# ============================================================================
# PHASE 2 · 🔁 REDIS (DISTRIBUTED STATE) + ⏱ GRANULAR RATE LIMITING
# ----------------------------------------------------------------------------
# Bot bir necha instance'da (Render/Docker: 2+ replica) ishlaganda holat
# (rate limit sanagichlari, kesh) UMUMIY manbada saqlanishi kerak —
# aks holda har instance o'z chegarasini alohida yuritadi va foydalanuvchi
# chegaradan o'tib ketadi. Redis — Ixtiyoriy (opt-in):
#   * REDIS_URL bo'sh yoki REDIS_ENABLED=0  → butunlay In-Memory rejim
#     (thread-xavfsiz LRU + TTL, 512 MB RAM uchun chegarali);
#   * Redis paketi o'rnatilmagan / server o'lgan / ulanish uzilgan →
#     avtomatik In-Memory fallback (circuit breaker, bot QULAMAYDI).
# Redis paketini o'rnatish:  pip install "redis>=5.0"
# ============================================================================
# REDIS_URL — masalan: redis://localhost:6379/0  yoki
# rediss://user:parol@host:6380/0 (TLS). BO'SH = Redis ishlatilmaydi.
# DIQQAT: parol DSN ichida — uni loglarga yozmang, faqat shu faylda saqlang.
REDIS_URL=
# REDIS_ENABLED — bayroq (1/0). Bo'sh qoldirilsa AVTOMATIK: URL bor bo'lsa
# 1, yo'q bo'lsa 0. Redis yo'q bo'lsa ham 1 qo'yish xavfsiz (fallback ishlaydi).
REDIS_ENABLED=
# REDIS_KEY_PREFIX — kalitlar prefiksi (boshqa ilovalar bilan to'qnashmasin).
REDIS_KEY_PREFIX=postassist
# REDIS_SOCKET_TIMEOUT — ulanish/buyruq timeout'i (soniya). Redis o'lsa
# fallback tez ishga tushishi uchun qisqa ushlab turiladi.
REDIS_SOCKET_TIMEOUT=2.0
# REDIS_MAX_CONNECTIONS — connection pool hajmi.
REDIS_MAX_CONNECTIONS=10
# REDIS_CIRCUIT_FAILURES — shuncha ketma-ket xatodan keyin breaker OCHILADI
# (Redis o'lganda har bir so'rov timeout bo'lib botni sekinlashtirmasin).
REDIS_CIRCUIT_FAILURES=3
# REDIS_CIRCUIT_COOLDOWN — breaker ochiq turgan davr (soniya); undan keyin
# yarim-ochiq (half-open) holatda bitta proba yuboriladi.
REDIS_CIRCUIT_COOLDOWN=30.0
# MEM_CACHE_MAX_ENTRIES / MEM_CACHE_MAX_VALUE_BYTES / MEM_CACHE_MAX_TOTAL_BYTES
# — In-Memory backend chegaralari (Render 512 MB RAM himoyasi): LRU yozuvlar
# soni, bitta qiymatning maksimal hajmi (bayt) va umumiy hajm (bayt).
MEM_CACHE_MAX_ENTRIES=20000
MEM_CACHE_MAX_VALUE_BYTES=65536
MEM_CACHE_MAX_TOTAL_BYTES=33554432

# ------------------------ ⏱ GRANULAR RATE LIMITING --------------------------
# Global «hammasini tozalash» emas — har bir harakat uchun ALOHIDA kalit va
# ALOHIDA TTL (middlewares/rate_limiter.py). Redis yoqilsa sanagichlar
# instance ichida qoladi; Redis bilan — barcha instance uchun umumiy.
# RATE_LIMIT_ENABLED=0 — barcha granullar o'chiriladi (diagnostika).
RATE_LIMIT_ENABLED=1
# 💬 Matnli xabarlar: 1 soniyada ko'pi bilan 2 ta.
RATE_LIMIT_MESSAGE_MAX=2
RATE_LIMIT_MESSAGE_WINDOW=1.0
# 🔘 Callback throttling: kalit (user_id, callback_action) — bir xil tugma
# ketma-ket bosilsa bloklanadi, BOSHQA tugma erkin bosiladi.
RATE_LIMIT_CALLBACK_MAX=1
RATE_LIMIT_CALLBACK_WINDOW=1.5
# 🤖 Qimmatli AI generatsiyasi: 4 soniyada 1 ta so'rov.
RATE_LIMIT_AI_MAX=1
RATE_LIMIT_AI_WINDOW=4.0
# 🔗 URL / RSS fetch (SSRF + DoS himoyasi): foydalanuvchi bo'yicha 60 s da
# 5 ta, butun bot bo'yicha 60 s da 120 ta (Redis bilan — barcha instance).
RATE_LIMIT_FETCH_MAX=5
RATE_LIMIT_FETCH_WINDOW=60.0
RATE_LIMIT_FETCH_GLOBAL_MAX=120
# RATE_LIMIT_AI_ACTIONS / RATE_LIMIT_FETCH_ACTIONS — vergul bilan ajratilgan
# callback action ro'yxati (bo'sh = modulning o'z standartlari).
RATE_LIMIT_AI_ACTIONS=
RATE_LIMIT_FETCH_ACTIONS=

# ---------------- KARTA ORQALI TO'LOV (Uzcard / Humo) ----------------
# Karta rekvizitlari kodda QATTIQ YOZILMAGAN (hardcode YO'Q) — ular FAQAT shu
# ikki o'zgaruvchidan olinadi (config.CARD_NUMBER / config.CARD_HOLDER).
# Bo'sh bo'lsa bot "rekvizitlar sozlanmagan, adminga murojaat qiling" deydi.
# Karta raqami: faqat raqamlar (bo'sh joysiz), bot 4 talab ajratib ko'rsatadi.
CARD_NUMBER=
CARD_HOLDER=
PAYMENT_ADMIN_USERNAME=
# --- YORDAM / QO'LLAB-QUVVATLASH (📖 Qo'llanma bo'limi) ---
# /help dagi "💬 Bog'lanish / Связаться с поддержкой" tugmasi shu username'ga
# (t.me/<username>) yo'naltiriladi. Bo'sh = PAYMENT_ADMIN_USERNAME ishlatiladi.
SUPPORT_USERNAME=

# ---------------- 💎 TARIFLAR: YAGONA MANBA (config.py) ----------------
# Narx/limitlar kodda qattiq yozilmagan — hammasi shu yerdan o'qiladi va
# butun ilova (pre_checkout, PaymentService, klaviaturalar) shu bitta
# manbadan foydalanadi. Qiymatlarni o'zgartirsangiz HAMMA joyda o'zgaradi.
# Tariflar narxi so'mda (karta orqali to'lov)
PAYMENT_PRICE_1M_UZS=19000
PAYMENT_PRICE_3M_UZS=45000
PAYMENT_PRICE_1Y_UZS=140000
# Telegram Stars narxlari
STARS_PRICE_1M=75
STARS_PRICE_3M=175
STARS_PRICE_1Y=550
# Taxminiy AQSH dollar ekvivalenti (faqat ko'rsatish uchun matn)
USD_EQUIV_1M=1.5
USD_EQUIV_3M=3.5
USD_EQUIV_1Y=11.0
# Tarif limitlari (FREE kanallar soni va kunlik AI so'rovlari)
FREE_MAX_CHANNELS=3
FREE_DAILY_AI=5
PRO_MAX_CHANNELS=999
PRO_DAILY_AI=999

# ---------------- IZOH: hujjatlashtirilmagan o'zgaruvchilar ----------------
# Testlar ichida ishlatiladigan ichki tugmalar (P0_TEST_DATABASE_URL,
# INTEGRITY_TEST_SKIP_LIVE, RBAC_TEST_SKIP_LIVE) .env GA YOZILMAYDI — ular
# faqat `tests/` ishga tushganda kerak bo'ladi va CI o'zi boshqaradi.
#
# QOIDA: yangi o'zgaruvchi qo'shilsa — IKKALA faylga ham bir xil qo'shiladi
# (.env.example va telegram_bot/.env.example); paritetni
# tests/env_docs_parity_test.py tekshiradi.
