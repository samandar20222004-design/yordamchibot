BOT_TOKEN=your_telegram_bot_token_here
ADMIN_ID=your_telegram_user_id_here
DATABASE_URL=postgresql://username:password@localhost:5432/dbname
PORT=10000

# --- AI (kamida bittasi kerak; barchasi bepul) ---
# Gemini: https://aistudio.google.com -> API key (kuniga ~1500 so'rov bepul)
GEMINI_API_KEY=
# Groq: https://console.groq.com -> API key (kuniga ~1000 so'rov bepul)
GROQ_API_KEY=
# OpenRouter (ixtiyoriy): https://openrouter.ai -> :free modellar uchun
OPENROUTER_API_KEY=
# Mistral (ixtiyoriy): https://console.mistral.ai -> oyiga ~1 mlrd token bepul
MISTRAL_API_KEY=
# Cerebras (ixtiyoriy): https://cloud.cerebras.ai -> kuniga 1M token bepul
CEREBRAS_API_KEY=
# SambaNova Cloud (ixtiyoriy): https://cloud.sambanova.ai -> 10-30 RPM bepul
SAMBANOVA_API_KEY=
# Cloudflare Workers AI (ixtiyoriy): https://dash.cloudflare.com -> Workers AI
# (kunlik 10K neuron). Tokendan tashqari ACCOUNT_ID ham kerak — endpoint
# https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1/chat/completions
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- Render Free optimallashtirish (ixtiyoriy, standart qiymatlar) ---
# PostgreSQL ulanishlar pool'i
DB_POOL_MIN=0
DB_POOL_MAX=5
DB_CONNECT_TIMEOUT=20
# Neon kabi TLS talab qiladigan bazalar uchun SSL rejimi.
# Bo'sh = avtomatik: masofaviy bazaga 'require', localhost'ga 'prefer'.
# URL ichida sslmode= bo'lsa URL'dagi ustun. Qiymatlar: disable|allow|prefer|require
DB_SSLMODE=
# Har bir scheduler ishlashida ko'pi bilan shuncha post yuboriladi
POST_BATCH_SIZE=100
# PostAssist V2 (5-BOSQICH): eski bazalarda NOT VALID holatda qolgan
# FK/CHECK constraintlarni ishga tushishda tekshirib tugatish.
# Katta jadvallarda qulf olishi mumkin — yuklama kam paytda yoqing.
# Bo'sh (default) = startup vaqtida tekshirilmaydi (`database.validate_integrity_constraints()`
# yordamchisi bilan ham qo'lda bajariladi).
DB_VALIDATE_INTEGRITY=
# PostAssist V2 (6-BOSQICH): RBAC rol keshining TTL'i (sekund).
# Rol DB'dan (`admin_roles` / `users.role`) o'qiladi va shu vaqt davomida
# keshlanadi; 0 = keshsiz (har tekshiruvda DB o'qiladi). Legacy ADMIN_ID /
# ADMIN_IDS tekshiruvi keshsiz va DB'siz ishlaydi.
RBAC_CACHE_TTL=60
# RBAC rolini DB'dan o'qish uchun maksimal kutish (sekund). Tekshiruv handler
# ichida bajariladi, shuning uchun o'qish alohida thread'da va shu chegarada
# kutish bilan amalga oshiriladi (sekin baza botni to'sib qo'ymaydi).
RBAC_DB_TIMEOUT=2
# TTL kesh (ixtiyoriy)
DB_CACHE_ENABLED=1
DB_SETTINGS_CACHE_TTL=60
DB_SPONSORS_CACHE_TTL=30
DB_USER_CACHE_TTL=15
DB_STATS_CACHE_TTL=30

# --- AI kontekst/parametrlar (ixtiyoriy; admin panelda ham sozlanadi) ---
# AI: bir vaqtda nechta so'rov ishlashi mumkin
MAX_CONCURRENT_AI=2
# 🛡 4-BOSQICH: Multi-Provider Fallback — har bir provayder so'rovi uchun
# qat'iy timeout (soniya). Timeout/429/5xx bo'lsa bot xatolik ko'rsatmasdan
# darhol keyingi provayderga o'tadi: Gemini → Groq → OpenRouter → zaxira.
AI_PROVIDER_CONNECT_TIMEOUT=3
AI_PROVIDER_READ_TIMEOUT=8
AI_PROVIDER_TOTAL_TIMEOUT=10
# Provayderlar zanjir tartibi (bo'sh = to'liq zanjir). Masalan:
# AI_PROVIDER_CHAIN=gemini,groq,openrouter — faqat yadro zanjir.
AI_PROVIDER_CHAIN=
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=1024
AI_TOP_P=1.0
AI_MAX_PROMPT_CHARS=3000
AI_CONTEXT_MESSAGES=6
AI_MAX_CONTEXT_CHARS=4000
# 🖼 Vision (Rasmdan post yaratish): rasm hajmi limiti va qat'iy vaqt chegarasi
VISION_MAX_FILE_BYTES=10485760
VISION_HARD_TIMEOUT=45
# 🖼 Vision uchun BARQAROR Gemini modeli. Bo'sh qoldirilsa gemini-2.5-flash.
# Eslatma: gemini-1.5-flash Google tomonidan 2025-09-29 da o'chirilgan
# (404 qaytaradi) — uni faqat kalitingizda amalda bo'lsa belgilang; aks
# holda barqaror zaxira zanjir avtomatik ishlaydi.
GEMINI_VISION_MODEL=gemini-2.5-flash

# --- KARTA ORQALI TO'LOV (Uzcard / Humo) ---
# Karta rekvizitlari kodda QATTIQ YOZILMAGAN (hardcode YO'Q) — ular FAQAT shu
# ikki o'zgaruvchidan olinadi (config.CARD_NUMBER / config.CARD_HOLDER).
# Render Environment yoki .env da nima yozilsa, to'lov oynasida AYNAN shu
# qiymatlar ko'rinadi. Bo'sh qoldirilsa bot "rekvizitlar sozlanmagan, adminga
# murojaat qiling" deb yozadi.
# Karta raqami: faqat raqamlar (bo'sh joysiz), bot 4 talab ajratib ko'rsatadi.
CARD_NUMBER=8600060950825589
# Karta egasining ismi (to'lov oynasida ko'rsatiladi)
CARD_HOLDER=Sayitqulov S.
PAYMENT_ADMIN_USERNAME=
PAYMENT_PRICE_1M_UZS=19000
PAYMENT_PRICE_3M_UZS=45000
PAYMENT_PRICE_1Y_UZS=140000

# Scheduler idempotentlik journali: post Telegramga chiqib, DB (Neon) qisqa
# uzilish tufayli 'posted' markeri yozilmay qolsa, fakt shu faylda saqlanadi —
# restartdan keyin ham post IKKI MARTA chiqmaydi. Bo'sh = /tmp dagi standart
# fayl; 'off' = faqat xotira (fayl yozilmaydi).
SENT_JOURNAL_PATH=

# ============================================================
# 🩺 PostAssist V2 (7-BOSQICH): SYSTEM HEALTH CHECK MONITORING
# ------------------------------------------------------------
# /health buyrug'i (faqat OWNER — system_settings ruxsati) tizim
# holatini ko'rsatadi: Neon DB latency, apscheduler holati, pending/
# failed/dead-letter postlar, AI provayderlar, uptime va xatolar.
# Quyidagi chegaralar DEGRADED (ogohlantirish) holatini sozlaydi.
# ============================================================
# Nechta dead-letter post bo'lsa DEGRADED deb hisoblanadi (default 1).
HEALTH_DEAD_LETTER_ALERT=1
# Nechta 'failed' post bo'lsa DEGRADED (default 10).
HEALTH_FAILED_ALERT=10
# Nechta kutilayotgan (pending) post bo'lsa navbat tiqilinchagi DEGRADED (default 1000).
HEALTH_PENDING_BACKLOG_ALERT=1000
